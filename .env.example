# =====================================================================
#  eKO Portal backend settings. Copy to .env and fill in the values.
#  Never commit .env to git.
# =====================================================================

APP_NAME="eKO Employee Portal"
APP_ENV=development                     # development | production
FRONTEND_URL=http://localhost:3000      # public URL of the Next.js site
CORS_ORIGINS=http://localhost:3000

# ---- Who may sign in --------------------------------------------------
# Comma-separated. Only M365 accounts on these domains can sign in.
ALLOWED_EMAIL_DOMAINS=changingtree.in
# These people become Super Admin automatically when they sign in.
SUPER_ADMIN_EMAILS=
SUPPORTED_LANGUAGES=en,hi,kn,ta,ml,te,mr

# ---- Microsoft Entra ID (Azure) app registration ----------------------
# From Entra admin center > App registrations > eKO Portal > Overview
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000      # Directory (tenant) ID
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000      # Application (client) ID
# From Certificates & secrets > Client secrets > New client secret (copy the VALUE)
AZURE_CLIENT_SECRET=
# Must exactly match a Web Redirect URI on the app registration
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/callback
AZURE_AUTHORITY_HOST=https://login.microsoftonline.com
AZURE_SCOPES=User.Read
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# true = signing out of eKO also signs the user out of Microsoft 365 in that browser
MS_SIGNOUT_ON_LOGOUT=false

# ---- MySQL ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=eko
DB_PASSWORD=change-me
DB_NAME=eko_portal

# ---- Session / inactivity ------------------------------------------------
SESSION_COOKIE_NAME=eko_session
SESSION_IDLE_TIMEOUT_MINUTES=1440       # 1440 = 1 day without activity -> signed out
SESSION_ABSOLUTE_TIMEOUT_DAYS=30        # hard cap even when active (0 = no cap)
SESSION_TOUCH_INTERVAL_SECONDS=60
COOKIE_SECURE=false                     # set true in production (HTTPS only)
COOKIE_DOMAIN=                          # blank = current host
LOGIN_STATE_TTL_MINUTES=10

# ---- Storage -------------------------------------------------------------
PHOTO_STORAGE_DIR=./storage/photos
